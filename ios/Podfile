platform :ios, '16.0'

source 'https://github.com/CocoaPods/Specs.git'

require_relative '../node_modules/react-native/scripts/react_native_pods'

prepare_react_native_project!

inhibit_all_warnings!

target 'CarAppClean' do
  config = use_native_modules!

  pod 'GoogleUtilities', :modular_headers => true
  pod 'RecaptchaInterop', :modular_headers => true
  pod 'AppCheckCore', :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => true,
    :fabric_enabled => true
  )

  post_install do |installer|
    react_native_post_install(installer)

    # Silence "placeholder.o has no symbols" from RecaptchaInterop's empty source file
    recaptcha_placeholder = File.join(
      installer.sandbox.root,
      'RecaptchaInterop/RecaptchaEnterprise/RecaptchaInterop/placeholder.m'
    )
    if File.exist?(recaptcha_placeholder)
      contents = File.read(recaptcha_placeholder)
      unless contents.include?('RecaptchaInteropPlaceholder')
        File.write(
          recaptcha_placeholder,
          contents + "\nvoid RecaptchaInteropPlaceholder(void) {}\n"
        )
      end
    end

    # Silence "NativeNitroModules+{Old,New}Arch.o has no symbols" — each file's body
    # is wrapped in an arch conditional, so the inactive one compiles to an empty .o.
    nitro_pod_dir = installer.sandbox.pod_dir('NitroModules')
    if nitro_pod_dir
      {
        'NativeNitroModules+OldArch.mm' => 'NitroModulesOldArchPlaceholder',
        'NativeNitroModules+NewArch.mm' => 'NitroModulesNewArchPlaceholder'
      }.each do |filename, symbol|
        path = File.join(nitro_pod_dir, 'ios/turbomodule', filename)
        next unless File.exist?(path)
        contents = File.read(path)
        next if contents.include?(symbol)
        File.write(path, contents + "\nvoid #{symbol}(void) {}\n")
      end
    end

    # Fix Folly coroutine issues + enforce minimum iOS deployment target
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        cppflags = config.build_settings['OTHER_CPLUSPLUSFLAGS'] || ['$(inherited)']
        unless cppflags.include?('-DFOLLY_CFG_NO_COROUTINES=1')
          cppflags << '-DFOLLY_CFG_NO_COROUTINES=1'
          config.build_settings['OTHER_CPLUSPLUSFLAGS'] = cppflags
        end

        current = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        if current.nil? || current.to_f < 16.0
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
        end
      end
    end

    # Silence script warnings
    installer.pods_project.targets.each do |target|
      target.build_phases.each do |phase|
        next unless phase.is_a?(Xcodeproj::Project::Object::PBXShellScriptBuildPhase)
        if phase.output_paths.nil? || phase.output_paths.empty?
          phase.always_out_of_date = "1"
        end
      end
    end

    # Fix Swift warnings
    installer.aggregate_targets.each do |aggregate_target|
      aggregate_target.xcconfigs.each do |config_name, config_file|
        config_file.attributes.delete('ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES')
        xcconfig_path = aggregate_target.xcconfig_path(config_name)
        config_file.save_as(xcconfig_path)
      end
    end

    # Xcode 16 recommended settings
    installer.pods_project.build_configurations.each do |config|
      config.build_settings['DEAD_CODE_STRIPPING'] = 'YES'
      config.build_settings['LOCALIZATION_PREFERS_STRING_CATALOGS'] = 'YES'
      config.build_settings['ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS'] = 'YES'
      config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
      config.build_settings['STRING_CATALOG_GENERATE_SYMBOLS'] = 'YES'
    end

    installer.pods_project.root_object.attributes['LastUpgradeCheck'] = '2650'
    installer.pods_project.root_object.attributes['LastSwiftUpdateCheck'] = '2650'
  end
end
