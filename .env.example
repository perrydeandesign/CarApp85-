# Copy to .env and fill in (the real .env is git-ignored — never commit secrets).
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>
# Server-only — used by the supabase/*.mjs scripts, NOT shipped in the app.
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
# Crash/error reporting. Leave blank to stay in console-only mode.
# Get it from Sentry → Project → Settings → Client Keys (DSN).
SENTRY_DSN=
